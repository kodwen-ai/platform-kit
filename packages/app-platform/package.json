{
  "name": "@kodwen/app-platform",
  "version": "0.2.1",
  "description": "codai app platform protocol v1: manifest, permissions, installations, app JWT, installation tokens, token exchange, Hono/Next adapters, typed client and conformance suite.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "bin": {
    "codai-platform-conformance": "./dist/conformance-cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "codai",
    "platform",
    "app-platform"
  ],
  "homepage": "https://kodwen.com",
  "bugs": "https://github.com/kodwen-ai/platform-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodwen-ai/platform-kit.git",
    "directory": "packages/app-platform"
  },
  "scripts": {
    "lint": "echo 'lint runs in the codai monorepo'",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "hono": "^4.13.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "fast-check": "^4.10.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "hono": "^4.13.13"
  }
}
